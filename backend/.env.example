# ── Core ──────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# Frontend URL (used in email links and redirects)
CLIENT_URL=https://theflexleather.com

# Backend API URL (used to build email verification links)
BASE_URL=https://api.theflexleather.com

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=https://theflexleather.com,https://www.theflexleather.com

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>

# ── JWT ───────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=<random-64-char-string>
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=<random-64-char-string>
REFRESH_TOKEN_EXPIRY=1d

# ── Email (Brevo SMTP) ────────────────────────────────────────────────────────
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=<brevo-smtp-login>
BREVO_SMTP_PASS=<brevo-smtp-password>
BREVO_VERIFIED_EMAIL=info@theflexleather.com

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=<access-key>
AWS_SECRET_ACCESS_KEY=<secret-key>
AWS_REGION=<region>
AWS_S3_BUCKET=<bucket-name>

# ── Payment Gateways ──────────────────────────────────────────────────────────
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_HASH_KEY=
JAZZCASH_ENV=production

EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ENV=production
